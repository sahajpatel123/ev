# EV API-first profile — Muse Spark 1.3 Contributor blessed configuration
#
# Copy to .env and fill the FILL-ME values. Reasoning is Muse Spark 1.3
# Contributor via the official Meta Model API (https://api.meta.ai/v1); local
# models stay only where an API is impossible or clearly worse (wake word,
# OCR via Apple Vision, speaker verification, embeddings, face recognition).
# ML posture is api-first (docs/MODELS.md §1a); the M2/8 GB host does not run
# local LLM inference.

# --- Identity / secrets (FILL-ME) ---
EV_MASTER_KEY=change-me
EV_VAULT_KEY=change-me-change-me-change-me
EV_BACKUP_PASSPHRASE=change-me
EV_API_KEY=change-me

# --- Native stack (launchd + brew Postgres 17 + Redis; compose is CI-only) ---
EV_DATABASE_URL=postgresql+psycopg://ev:ev@localhost:5432/ev
EV_REDIS_URL=redis://localhost:6379/0
EV_PROCESSING_MODE=queue
EV_OBJECT_STORE_BACKEND=local
EV_STORAGE_ROOT=./storage
EV_BACKUP_RETENTION_COUNT=7
EV_BACKUP_DIR=~/.ev/backups

# --- Reasoning: Muse Spark 1.3 Contributor (one mind, every channel) ---
EV_CHAT_PROVIDER=meta_muse_spark
EV_INTELLIGENCE_PROVIDER=meta_muse_spark
EV_TURN_CONTROL_PROVIDER=meta_muse_spark
EV_TURN_CONTROL_MODEL=muse-spark-1.3-contributor
EV_CODE_MODEL=muse-spark-1.3-contributor
EV_COGNITIVE_MODE=muse_kernel
EV_MUSE_SPARK_MODEL=muse-spark-1.3-contributor
EV_MUSE_SPARK_BASE_URL=https://api.meta.ai/v1
EV_MUSE_SPARK_REASONING_EFFORT=high
EV_COGNITIVE_CONVERSATION_REASONING_EFFORT=low
EV_COGNITIVE_WORK_REASONING_EFFORT=medium
EV_COGNITIVE_CONVERSATION_MAX_TOOL_TURNS=4
META_MODEL_API_KEY=               # FILL-ME: official Meta Model API key, local .env only
                                   # (also accepts EV_META_MODEL_API_KEY / MODEL_API_KEY)
# --- Alternate chat route: local opencode serve → hosted models (owner's key) ---
# Kept provisioned as a fallback provider (EV_CHAT_PROVIDER=opencode). Spark
# remains the blessed mind; opencode is not a cognitive inference route.
#   EV_OPENCODE_BASE_URL=http://localhost:4096
#   EV_OPENCODE_PROVIDER_ID=opencode-go
#   EV_OPENCODE_MODEL=deepseek-v4-flash
#   EV_OPENCODE_AGENT=ev-minimal
#   OPENCODE_API_KEY=               # FILL-ME only if using the opencode fallback

# Enforceable monthly spend guard (app/gateway/costs.py): requests are refused
# when the current month's projected spend would exceed the cap.
EV_MONTHLY_COST_CAP_USD=40
EV_COST_CAP_ENABLED=true

# --- ASR/TTS: what Agent 2 actually shipped ---
# Parakeet/Kokoro weights are not in the registry yet, so the working defaults
# are faster_whisper ASR and hosted openai_compat TTS (remote explicitly
# allowed). Switch to kokoro when the package + weights land.
EV_VOICE_ASR_PROVIDER=faster_whisper
EV_VOICE_ASR_MODEL=base
EV_VOICE_TTS_PROVIDER=openai_compat
EV_ALLOW_REMOTE_TTS=true
EV_VOICE_TTS_BASE_URL=          # FILL-ME for real spoken replies
EV_VOICE_TTS_API_KEY=           # FILL-ME for real spoken replies

# --- Speaker verification: CAM++ (biometric privacy, local) ---
# HARD REQUIREMENT: default_speaker_verifier() refuses the hash double outside
# pytest (backend/app/voice/speaker.py). With EV_VOICEPRINT_PROVIDER=campp and
# no exported .onnx in EV_VOICEPRINT_MODEL_DIR, the voice path refuses to
# start — that is correct fail-closed behavior, not a bug.
EV_VOICEPRINT_PROVIDER=campp
EV_VOICEPRINT_MODEL_DIR=~/.ev/models

# --- Vision: Apple Vision framework via the evvision Swift helper (free) ---
# Build once:  (cd helpers/evvision && swift build -c release)
EV_VISION_PROVIDER=apple_vision
EV_VISION_EVVISION_BINARY=evvision

# --- Wake word: custom openWakeWord EVIE head (local, always tier) ---
EV_VOICE_WAKE_PROVIDER=openwakeword
EV_VOICE_WAKE_OPENWAKEWORD_MODEL_PATH=~/.ev/models/wake-openwakeword.onnx
EV_VOICE_WAKE_OPENWAKEWORD_VERIFIER_PATH=~/.ev/models/wake-openwakeword-verifier.pkl

# --- Embeddings: Agent 8 recommendation (granite R2, verified, on_demand) ---
EV_EMBEDDING_PROVIDER=granite
EV_EMBEDDING_DIM=384

# --- Face recognition: SFace ONNX (verified, on_demand) ---
EV_FACE_PROVIDER=sface

# --- ML posture ---
EV_ML_POSTURE=api-first

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sahajpatel123/ev/blob/main/docs/schemas/ev-hud-card-v1.json",
  "title": "EV HUD card",
  "description": "ev.hud.card.v1 — one validated JSON card rendered by Watch complications, widgets, Mac dashboard, web workbench, and CLI (`ev card`).",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "title",
    "body",
    "priority"
  ],
  "properties": {
    "schema_version": {
      "const": "ev.hud.card.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "priority": {
      "type": "number",
      "minimum": 0
    },
    "meta": {
      "type": "object"
    }
  },
  "additionalProperties": true
}

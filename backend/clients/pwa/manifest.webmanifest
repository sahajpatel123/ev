{
  "name": "Evie",
  "short_name": "Evie",
  "start_url": "/evie/",
  "scope": "/evie/",
  "display": "standalone",
  "background_color": "#f4efe6",
  "theme_color": "#f4efe6",
  "icons": [
    {
      "src": "/evie/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/evie/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "x-evie-cycle-42-turn-receipts": {
    "note": "Cycle 42 \u2014 iPhone-only turn-receipts list model. Backward compatible: additive namespaced key; statuses enumerate per-turn delivery states.",
    "statuses": [
      "sent",
      "delivered",
      "played"
    ]
  },
  "x-evie-cycle-43-large-text": {
    "note": "Cycle 43 \u2014 iPhone-only large-text accessibility flag. Backward compatible: additive namespaced key; default off.",
    "default": false
  }
}

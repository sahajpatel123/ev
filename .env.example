# EV configuration (copy to .env)
EV_ENVIRONMENT=dev
EV_DATABASE_URL=postgresql+psycopg://ev:ev@localhost:5432/ev
EV_REDIS_URL=redis://localhost:6379/0

# Single-user master key. CHANGE THIS.
EV_MASTER_KEY=change-me

# sync = process events inline (no Redis needed); queue = Redis/RQ workers
EV_PROCESSING_MODE=sync

# Memory OS: Postgres Events are authority. OpenAI Realtime sessions are disposable.
# off = current live turn-taking (frozen). shadow = measure router only. on is not
# enabled until latency evidence; it still must not rewrite create_response.
EV_MEMORY_GATE=off
# Private rebuildable mirror. Default on macOS:
# ~/Library/Application Support/EV/memory
# Never put owner memories inside the git checkout.
EV_MEMORY_DIR=
# WhatsApp takeout zips for named-chat recaps. Empty = <repo>/data/life-archive
# when that folder exists. Never commit that tree.
EV_LIFE_ARCHIVE_ROOT=
EV_MEMORY_CURATOR_ENABLED=true
EV_MEMORY_CURATOR_VERSION=1.1
EV_MEMORY_CURATOR_BATCH_EVENTS=8
EV_MEMORY_BOOTSTRAP_MAX_TOKENS=1400
# Silent prefetch never injects into the model. Default off.
EV_MEMORY_PREFETCH=off

# Cross-platform Device Gateway / PWA. Production Memory OS stays off.
EV_CROSS_PLATFORM_ENABLED=true
EV_CROSS_PLATFORM_PRODUCTION_MEMORY=false
EV_DEVICE_PROTOCOL_VERSION=1
EV_PWA_BUILD=2026.09.05.03
EV_NATIVE_ACTIONS_ENABLED=true
# Phone media rides pcm_ws through the EV server bridge to Gemini Live
# (direct browser WebRTC is retired). The ASR oracle transcribes
# diagnostic audio via Gemini REST.
EV_PHONE_AUDIO_BACKEND=pcm_ws
EV_PHONE_ASR_MODEL=gemini-2.5-flash
EV_PHONE_ASR_LANGUAGE=en
EV_PHONE_INPUT_NOISE_REDUCTION=far_field
EV_PWA_DESIGN_VERSION=veil-1
# Set to 1 only to run: tailscale serve --bg --https=443 http://127.0.0.1:8000
EV_TAILSCALE_SERVE_APPLY=0
EV_HOME_STATION_MODE=true
EV_HOME_STATION_KEEP_AWAKE_ON_AC=true
EV_HOME_STATION_KEEP_AWAKE_ON_BATTERY=false

# Embeddings: hash (offline dev) or http (OpenAI-compatible embedding API)
EV_EMBEDDING_PROVIDER=hash
EV_EMBEDDING_BASE_URL=https://api.openai.com/v1
EV_EMBEDDING_API_KEY=
EV_EMBEDDING_MODEL=text-embedding-3-small
EV_EMBEDDING_DIM=384

# Voiceprint enrollment: hash (offline dev/tests), speechbrain (local
# ECAPA-TDNN), or http (remote encoder service). Hosted/remote encoders
# require explicit voice_enrollment consent with allow_remote_processing=true.
EV_VOICEPRINT_PROVIDER=hash
EV_VOICEPRINT_BASE_URL=
EV_VOICEPRINT_API_KEY=
EV_VOICEPRINT_MODEL=speechbrain/spkrec-ecapa-voxceleb
EV_VOICEPRINT_MODEL_DIR=
EV_VOICEPRINT_DIM=192
EV_VOICEPRINT_THRESHOLD=0.72

# Voice wake word: phrase (dev/test), porcupine (Picovoice + custom EVIE .ppn),
# or silero_vad (Porcupine/phrase + Silero VAD speech gate).
EV_VOICE_WAKE_PROVIDER=phrase
EV_VOICE_WAKE_ACCESS_KEY=
EV_VOICE_WAKE_MODEL_PATH=
EV_VOICE_WAKE_PORCUPINE_LIBRARY_PATH=
EV_VOICE_WAKE_SENSITIVITY=0.6
EV_VOICE_WAKE_VAD_MODEL_PATH=
EV_VOICE_WAKE_VAD_THRESHOLD=0.5

# Voice ASR: echo (offline text hints — cannot hear live PCM),
# faster_whisper (local; required for EV.app live conversation), or
# openai_compat (any OpenAI-compatible /audio/transcriptions endpoint;
# requires EV_ALLOW_REMOTE_ASR=true). Live sessions fall back to a local
# tiny Whisper when this is still echo, so speech is never silently dropped.
EV_VOICE_ASR_PROVIDER=faster_whisper
EV_VOICE_ASR_BASE_URL=
EV_VOICE_ASR_API_KEY=
EV_VOICE_ASR_MODEL=tiny
EV_VOICE_ASR_MODEL_DIR=
EV_VOICE_ASR_DEVICE=auto
EV_VOICE_ASR_COMPUTE_TYPE=auto
EV_VOICE_ASR_LANGUAGE=
EV_VOICE_ASR_VAD_FILTER=true
# Bound utterance audio / ASR / chat+TTS so push-to-talk cannot hang until
# the menu-bar client's 90s timeout (the previous default was 60s).
EV_VOICE_UTTERANCE_MAX_SECONDS=15
EV_VOICE_ASR_TIMEOUT_SECONDS=20
EV_VOICE_TURN_TIMEOUT_SECONDS=35
EV_VOICE_TTS_TIMEOUT_SECONDS=12
# Wake-mode no-speech suppression. 0.6 (Whisper's default) keeps real short
# "EVIE" clips audible to the spotter; lowering it re-suppresses them.
EV_VOICE_ASR_WAKE_NO_SPEECH_THRESHOLD=0.6

# Voice TTS: meta (offline SSML metadata), piper (local ONNX voice), or
# openai_compat (any OpenAI-compatible /audio/speech endpoint).
# Urgency/warmth/brevity map to speed + prosody; the voice stays consistent.
EV_VOICE_TTS_PROVIDER=meta
EV_VOICE_TTS_BASE_URL=
EV_VOICE_TTS_API_KEY=
EV_VOICE_TTS_MODEL=en_US-lessac-medium.onnx
EV_VOICE_TTS_MODEL_DIR=
EV_VOICE_TTS_BINARY=piper
EV_VOICE_TTS_VOICE=alloy
EV_VOICE_TTS_FORMAT=mp3
EV_VOICE_TTS_LENGTH_SCALE=1.0
EV_VOICE_TTS_NOISE_SCALE=0.667
EV_VOICE_TTS_SENTENCE_SILENCE=0.2

# Chat: echo (offline CI), mock (tests), or mimo (MiMo-V2.6-Flash, the
# non-speech brain). Live talk is speech-to-speech, not chat-completions.
# Daily split: EV_CHAT_PROVIDER=mimo types;
# EV_VOICE_LIVE_BRAIN=auto uses Gemini Live when EV_GOOGLE_API_KEY is set
# (paid tier only), else the local pipeline.
EV_CHAT_PROVIDER=echo

# Vision / OCR. Official api.deepseek.com is text-only and cannot OCR.
# Darwin uses Apple Vision when helpers/evvision is built. Optional
# self-hosted DeepSeek-OCR: EV_VISION_PROVIDER=deepseek_ocr and
# EV_VISION_DEEPSEEK_OCR_URL=http://127.0.0.1:8090/ocr
EV_VISION_PROVIDER=deterministic
EV_VISION_TESSERACT_BINARY=tesseract
EV_VISION_DEEPSEEK_OCR_URL=
EV_VISION_DEEPSEEK_OCR_TIMEOUT=20

# gemini = Gemini Live speech-to-speech (live talk). auto = Gemini Live
# when the key is set, else the local pipeline. pipeline = local ASR +
# chat + TTS. (Legacy openai/xai brain values map to gemini.)
EV_VOICE_LIVE_BRAIN=auto
# Google AI API key for Gemini Live speech. Paid tier only: free-tier
# traffic may be used to improve Google's products.
EV_GOOGLE_API_KEY=
EV_GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking
EV_GEMINI_LIVE_VOICE=Aoede
EV_GEMINI_LIVE_REASONING_EFFORT=low
EV_GEMINI_LIVE_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent

# Local model (Ollama/llama.cpp OpenAI-compatible endpoint)
EV_LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
EV_LOCAL_MODEL_NAME=llama3

# Web research: none (memory-only), mock (tests), brave (user-supplied key),
# or live (Open-Meteo weather with no key + Wikipedia/DuckDuckGo; uses Brave
# automatically when EV_BRAVE_SEARCH_API_KEY is set).
EV_SEARCH_PROVIDER=none
EV_BRAVE_SEARCH_API_KEY=
EV_BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
EV_LOCATION_PLACE=
EV_HOME_LAT=
EV_HOME_LON=
EV_HOME_GEOFENCE_M=80

# Local model server (Ollama/llama.cpp OpenAI-compatible endpoint) — plan 4.4.
# Set EV_CHAT_PROVIDER=local to route chat to a machine-local model.
EV_PERSONA_NAME=EV
EV_PERSONA_DESCRIPTION="the owner's personal AI - house, phone, workshop, and visor"
EV_MODEL_CALL_LOG_ENABLED=true

# Intelligence filter: optional provider-backed critic (staged trust)
EV_FILTER_CRITIC_ENABLED=false
EV_FILTER_CRITIC_MAX_ITERATIONS=2
EV_FILTER_CRITIC_MODES=coaching,emergency,analytical

# Weight training (Domain 7): explicit provider boundary for adapter
# fine-tuning. local-lora runs a configured command against the exported JSONL;
# mlx-lora trains on Apple silicon. No hosted vendor path.
EV_TRAINING_PROVIDER=local-lora
EV_TRAINING_LOCAL_CMD=

# --- AGENT 11 FORGE ---
# Real local LoRA trainer (mlx-tune on Apple Silicon). Provider name: mlx-lora.
# The 200-pair floor guards against overfitting; the arbiter exclusive lock
# (trainer-mlx-lora) is acquired automatically and refuses concurrent holders.
EV_TRAINING_LORA_BASE_MODEL=Qwen/Qwen3-0.6B
EV_TRAINING_LORA_OUTPUT_ROOT=~/.ev/adapters
EV_TRAINING_LORA_MIN_OWNER_PAIRS=200
EV_TRAINING_LORA_MAX_SEQ_LENGTH=512
EV_TRAINING_LORA_RANK=16
EV_TRAINING_LORA_LORA_ALPHA=32
EV_TRAINING_LORA_LORA_DROPOUT=0.05
EV_TRAINING_LORA_LEARNING_RATE=0.0001
EV_TRAINING_LORA_NUM_EPOCHS=3
EV_TRAINING_LORA_TRAIN_MODE=sft
EV_TRAINING_LORA_BATCH_SIZE=1
EV_TRAINING_LORA_GRAD_CHECKPOINT=true
EV_TRAINING_LORA_USE_4BIT=true
EV_TRAINING_LORA_EVAL_FRACTION=0.2
EV_TRAINING_LORA_SEED=42
EV_TRAINING_LORA_FORCE_DOUBLE=false

EV_CONTEXT_BUDGET_TOKENS=20000
EV_MAX_RETRIEVAL_MEMORIES=50

EV_OBJECT_STORE_BACKEND=local
EV_STORAGE_ROOT=./storage
EV_ACCESS_LOG_ENABLED=true

# Legal & biometric compliance (regional policy)
# Region drives default retention windows and disclosure text:
# global | eu | uk | us | us-il | in
EV_REGION=global

# Retention windows in days. -1 = keep until the user deletes; 0 = destroy as
# soon as the purpose ends (e.g. voice enrollment revocation).
EV_RETENTION_VOICEPRINT_DAYS=-1
EV_RETENTION_TRAINING_SNAPSHOT_DAYS=-1
EV_RETENTION_LIVE_AUDIO_DAYS=0
EV_RETENTION_ACCESS_LOG_DAYS=730
EV_RETENTION_EVENT_DAYS=-1
EV_RETENTION_INTEGRATION_CACHE_DAYS=0

# Residency: local (never leave the machine) | region | cloud
EV_RESIDENCY_MODE=local

# Remote processing gates. All default to denied (fail closed); enable only for
# deployments that have obtained the corresponding consent.
EV_ALLOW_REMOTE_VOICEPRINT_PROCESSING=false
EV_ALLOW_REMOTE_ASR=false
EV_ALLOW_REMOTE_TRAINING=false
EV_ALLOW_REMOTE_LIFE_DATA=false
EV_ALLOW_REMOTE_FILTER_TRAINING=false

# Integrations & ecosystem
# REQUIRED: dedicated key for encrypting integration OAuth tokens and webhook
# secrets. EV never derives this from EV_MASTER_KEY. Generate a random value,
# e.g. `openssl rand -base64 48` (min 16 chars), and store it with your other
# secrets. Rotating it later requires POST /v1/integrations/vault/rotate.
EV_VAULT_KEY=change-me-to-a-random-48-byte-secret

# Webhook ingress hardening
EV_WEBHOOK_MAX_SKEW_SECONDS=300
EV_WEBHOOK_RATE_LIMIT=60
EV_WEBHOOK_WINDOW_SECONDS=60
EV_WEBHOOK_MAX_BODY_BYTES=1048576

# Plugin sandbox limits
EV_PLUGIN_TIMEOUT_SECONDS=3
EV_PLUGIN_MAX_OUTPUT_BYTES=65536

# Backup & retention
# User-held backup passphrase; never reuse EV_MASTER_KEY for backups.
EV_BACKUP_PASSPHRASE=
EV_BACKUP_RETENTION_COUNT=7
EV_TOMBSTONE_BLOB_RETENTION_DAYS=30

# Live data & sensors
# Raw live events are append-only; retention physically deletes only consumed
# events past the window. Rebuild regenerates derived state from the stream.
EV_LIVE_EVENT_RETENTION_DAYS=90
EV_LIVE_RETENTION_INTERVAL_SECONDS=86400
EV_LIVE_REBUILD_INTERVAL_SECONDS=3600

# Collector agent (see docs/LIVE_DATA.md)
# EV_API_URL=http://127.0.0.1:8000
# EV_API_KEY=
# EV_DEVICE_ID=mac-collector
# EV_SCREEN_CHANNEL_ID=
# EV_AUDIO_CHANNEL_ID=
# EV_LOCATION_CHANNEL_ID=
# EV_SCREEN_PRIVACY=sensitive
# EV_AUDIO_PRIVACY=sensitive
# EV_LOCATION_PRIVACY=private

# --- AGENT 3 EARS (append-only) ----------------------------------------------
# Always-on microphone capture + VAD + wake + audio scene (docs/AUDIO.md).
# Offline defaults are deterministic; real engines activate when a model path
# is configured and the optional dependency is installed.
EV_VOICE_WAKE_OPENWAKEWORD_MODEL_PATH=
EV_VOICE_WAKE_OPENWAKEWORD_VERIFIER_PATH=
EV_VOICE_WAKE_OPENWAKEWORD_THRESHOLD=0.5
EV_VOICE_WAKE_OPENWAKEWORD_VERIFIER_THRESHOLD=0.3

# Microphone capture
EV_EARS_DEVICE=
EV_EARS_SAMPLE_RATE=16000
EV_EARS_RING_SECONDS=10.0
EV_EARS_BLOCK_MS=20
EV_EARS_DEVICE_ID=mac-ears

# VAD (Silero ONNX when present; energy/ZCR heuristic otherwise)
EV_EARS_VAD_MODEL_PATH=
EV_EARS_VAD_THRESHOLD=0.5
EV_EARS_VAD_PRE_ROLL_S=0.25
EV_EARS_VAD_POST_ROLL_S=0.75
EV_EARS_VAD_MIN_SPEECH_S=0.2
EV_EARS_MAX_SEGMENT_S=60.0

# Wake threshold used by the ears process (tuned against ambient audio)
EV_EARS_WAKE_THRESHOLD=0.5

# On-device wake fallback when the custom openWakeWord head is missing: the
# ears process runs a small local faster-whisper model (EV_EARS_WAKE_ASR_MODEL)
# to spot "EVIE" and the server trusts its confidence, instead of shipping
# every VAD segment to the API for a server-side Whisper pass.
EV_EARS_WAKE_LOCAL_SPOTTER=true
EV_EARS_WAKE_ASR_MODEL=tiny

# Stuck-mic / self-echo loops: drop segments whose content literally repeats
# before they reach ASR (docs/VOICE.md §0).
EV_EARS_STUCK_LOOP_DROP=true
EV_EARS_STUCK_LOOP_THRESHOLD=0.10

# Stream TTS chunks back over SSE and play each sentence as it arrives,
# instead of waiting for the full reply (docs/VOICE.md §6).
EV_EARS_STREAM_PLAYBACK=true

# Prefer the full-duplex WS /v1/voice/live door over per-utterance SSE once
# a voice session is awake. Raw PCM flows continuously; barge-in stops
# playback instantly (docs/LIVE_VOICE.md).
EV_EARS_LIVE_ENABLED=true

# Audio scene (YAMNet ONNX when present; VAD-feature fallback otherwise)
EV_EARS_SCENE_MODEL_PATH=
EV_EARS_SCENE_LABELS_PATH=

# Diarization (on-demand, meeting recordings only; consent defaults to false)
EV_EARS_DIARIZE_CONSENT=false
EV_EARS_DIARIZE_HF_TOKEN=

# Acceptance-gate datasets (owner-consented recordings; see docs/AUDIO.md §6)
EV_EARS_DATA_WAKE_DIR=
EV_EARS_DATA_AMBIENT_PATH=
EV_EARS_DATA_VAD_LABELS=
EV_EARS_DATA_SCENE_LABELS=

# Delivery + privacy. Raw audio is never persisted by default and only reaches
# Agent 4 when consent is explicitly enabled and an API URL is configured.
EV_EARS_API_URL=
EV_EARS_API_KEY=
EV_EARS_CONSENT=false
EV_EARS_DRY_RUN=false
EV_EARS_SAVE_SEGMENTS_DIR=
EV_EARS_REPORT_INTERVAL_S=300

# --- AGENT 4 VOICE — production on-device engines (additive) ---
# The reconciled defaults for the real ASR/TTS engines. The legacy
# EV_VOICE_ASR_MODEL / EV_VOICE_TTS_MODEL values above apply only to
# openai_compat/piper providers.
EV_VOICE_ASR_ENGINE=parakeet-eou-120m-int8
EV_VOICE_ASR_ALT_ENGINE=parakeet-tdt-v3-int8
EV_VOICE_ASR_STREAM_CHUNK_MS=200
# edge_tts = remote Microsoft neural voices (free, no key). en-GB-SoniaNeural is
# the closest public match to the movie E.V. (Naomi Watts) profile. Voice
# consistency is enforced: no cross-engine fallback, so remote failure means a
# text-only reply. kokoro = fully local on-device engine.
EV_VOICE_TTS_ENGINE=kokoro-82m-fp16
EV_VOICE_TTS_KOKORO_VOICE=bf_alice
EV_VOICE_TTS_EDGE_VOICE=en-GB-SoniaNeural
EV_VOICE_TTS_RETRIES=2
EV_VOICE_TTS_SAY_VOICE=Ava
EV_VOICE_CHATTERBOX_ENGINE=chatterbox-nano
EV_VOICE_CHATTERBOX_VOICE=default

# Remote TTS is fail-closed like remote ASR; enable only with consent.
EV_ALLOW_REMOTE_TTS=true

# --- AGENT 14 PULSE (append-only) -------------------------------------------
# Notification delivery backend: console (CI double) | macos | webhook | apns.
EV_NOTIFY_BACKEND=console
EV_NOTIFY_MACOS_HELPER_PATH=
EV_NOTIFY_MACOS_BUILD_DIR=./storage/notify
EV_NOTIFY_MACOS_BUNDLE_ID=ev.pulse
EV_NOTIFY_MACOS_ALLOW_OSASCRIPT=true
# Point at SUIT's packaged helper (single native delivery path):
#   EV_NOTIFY_MACOS_HELPER_PATH=/Applications/EV.app/Contents/MacOS/EVNotificationHelper

# Webhook delivery (signed with HMAC-SHA256 when a secret is set).
EV_NOTIFY_WEBHOOK_URL=
EV_NOTIFY_WEBHOOK_SECRET=

# APNs is wired end-to-end: SUIT's app uploads its token to
# POST /v1/devices/{id}/push-token; delivery activates when these are set.
EV_NOTIFY_APNS_ENABLED=false
EV_NOTIFY_APNS_KEY_ID=
EV_NOTIFY_APNS_TEAM_ID=
EV_NOTIFY_APNS_TOPIC=
EV_NOTIFY_APNS_KEY_PATH=

# Attention budget: quiet hours use EV_QUIET_HOURS_START/END and the daily cap
# is EV_DAILY_ALERT_BUDGET. These govern delivery retries/dedup.
EV_NOTIFY_MAX_ATTEMPTS=3
EV_NOTIFY_RETRY_INTERVAL_SECONDS=300
EV_NOTIFY_DEDUP_WINDOW_SECONDS=3600
EV_NOTIFY_EMERGENCY_PRIORITY_THRESHOLD=0.7
EV_NOTIFY_DIGEST_ENABLED=true
EV_NOTIFY_BOOT_BEACON=true
EV_NOTIFY_DEVICE_ROUTING=true

# WAVE LIFE fleet registry: `uv run python -m app.notify.registry --tokens`
# seeds Mac + Phone A + Phone B once and prints their bearer tokens.

# --- AGENT 12 CONDUIT (append-only) -------------------------------------------
# Real OAuth integrations (Google Calendar, GitHub). Client ids/secrets are
# server-side environment secrets; user access/refresh tokens go into the
# encrypted vault, never into these variables or integration config.
# Empty values are the offline CI double: authorize/refresh fail closed with a
# clear "not configured" message until the human fills them in.
EV_GOOGLE_OAUTH_CLIENT_ID=
EV_GOOGLE_OAUTH_CLIENT_SECRET=
EV_GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/v1/integrations/oauth/callback
EV_GITHUB_OAUTH_CLIENT_ID=
EV_GITHUB_OAUTH_CLIENT_SECRET=
EV_GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/v1/integrations/oauth/callback

# OAuth state TTL (seconds) and provider HTTP timeout.
EV_OAUTH_STATE_TTL_SECONDS=600
EV_OAUTH_HTTP_TIMEOUT_SECONDS=15

# Calendar sync horizon and per-pull cap (≥ 7 days recommended).
EV_CALENDAR_SYNC_DAYS=14
EV_CALENDAR_SYNC_MAX_EVENTS=50

# --- AGENT 12 CONDUIT · WAVE LIFE (append-only) ------------------------------
# Apple life bridges (Messages/Contacts/Phone/FaceTime/Mail) via Agent 18's
# EVLifeHelper, plus the iPhone device-proxy queue. Empty helper path = life
# actions fail loudly; local mode NEVER fakes a sent message or placed call.
EV_LIFE_HELPER_PATH=
EV_MESSAGING_PROVIDER=local
EV_LIFE_AUTONOMY=default
EV_LIFE_CONTACT_ALLOWLIST=all
EV_LIFE_CONFIRM_UNKNOWN=true
EV_LIFE_HELPER_TIMEOUT_SECONDS=20
EV_LIFE_HELPER_MAX_OUTPUT_BYTES=65536

# --- AGENT 10 CORTEX (API-only operation) ---
# MiMo-V2.6-Flash (via OpenRouter) is the only non-speech reasoning brain;
# Gemini 3.8 Live fronts speech. Nothing requires a local model:
# memory/timeline/recall work fully offline on deterministic doubles.
# Optional future local brain (human action, ~1.1 GB):
#   ollama pull qwen3:1.7b
#   # EV_LOCAL_MODEL_NAME=qwen3:1.7b
# Reliability knobs (defaults are safe): timeouts, retries, circuit breaker,
# and the enforceable monthly cost cap (default $40/month).
# EV_MODEL_CONNECT_TIMEOUT_SECONDS=10
# EV_MODEL_READ_TIMEOUT_SECONDS=60
# EV_MODEL_MAX_RETRIES=2
# EV_CIRCUIT_FAILURE_THRESHOLD=3
# EV_CIRCUIT_COOLDOWN_SECONDS=30
# EV_MONTHLY_COST_CAP_USD=40

# Life agency (WAVE LIFE): full = act inside granted standing scopes without
# per-action approval; confirm_unknown = known contacts act, unknown recipients
# need confirmation; confirm_all = every life action needs explicit approval.
EV_OWNER_AUTONOMY=full

# --- AGENT 10 CORTEX (OpenRouter / MiMo-V2.6-Flash brain; opt-in) ---
# MiMo is the non-speech brain: typed chat, kernel turns, coded decisions.
# Store the key only in the local secrets file, never in git.
EV_MIMO_ENABLED=false
EV_MIMO_MODEL=xiaomi/mimo-v2.6-flash
EV_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EV_OPENROUTER_API_KEY=
# Remote calls additionally require the existing owner egress gate and an
# active, revocable chat_egress consent record:
#   EV_ALLOW_REMOTE_CHAT=true
# --- END AGENT 10 CORTEX (OpenRouter / MiMo) ---

# --- AGENT 20 LAUNCH (append-only) ---
# Native stack: filesystem object store is the daily driver; MinIO/Compose is
# CI-only. Nightly backups use EV_BACKUP_PASSPHRASE (user-held, >= 8 chars)
# and write to EV_BACKUP_DIR (default ~/.ev/backups).
EV_BACKUP_DIR=~/.ev/backups

# ML eval artifact overrides (optional; defaults to backend/eval/ml/<gate>.json)
EV_ASR_EVAL_REPORT=
EV_SPEAKER_EVAL_REPORT=
EV_RETRIEVAL_EVAL_REPORT=
EV_FACE_EVAL_REPORT=
EV_WAKE_EVAL_REPORT=
EV_GROUNDING_EVAL_REPORT=

# --- WORKING PROFILE (MiMo brain + Gemini Live voice) ---
# Copy these into .env to turn the doubles into the daily voice assistant.
# Secrets stay local and are never committed.
#
# Typed brain: MiMo-V2.6-Flash over OpenRouter. Gemini-decides: Gemini Live
# answers speech directly and calls delegate_task for medium-high work.
# Live talk uses Gemini Live (`gemini-3.8-live-extended-thinking`) when
# EV_GOOGLE_API_KEY is set (paid tier only).
#   EV_CHAT_PROVIDER=mimo
#   EV_MIMO_ENABLED=true
#   EV_OPENROUTER_API_KEY=sk-...       # from https://openrouter.ai
#   EV_MIMO_MODEL=xiaomi/mimo-v2.6-flash
#   EV_VOICE_LIVE_BRAIN=gemini
#   EV_GOOGLE_API_KEY=                 # from https://aistudio.google.com — live talk (paid tier)
#   EV_GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking
#   EV_GEMINI_LIVE_VOICE=Aoede
#
# Voice: use what Agent 2 actually shipped. Parakeet/Kokoro weights are not
# in the registry yet, so the working defaults are faster_whisper ASR and
# hosted openai_compat TTS (remote must be explicitly allowed).
#   EV_VOICE_ASR_PROVIDER=faster_whisper
#   EV_VOICE_TTS_PROVIDER=openai_compat
#   EV_ALLOW_REMOTE_TTS=true
#   EV_VOICE_TTS_BASE_URL=             # fill for real spoken replies
#   EV_VOICE_TTS_API_KEY=              # fill for real spoken replies
#
# Biometric privacy stays local (fail-closed until weights exist):
#   EV_VOICEPRINT_PROVIDER=campp
#   EV_VOICE_WAKE_PROVIDER=openwakeword

# --- HANDS-FREE VOICE (append-only) -----------------------------------------
# auto = Vosk (wake+ASR) and Piper (TTS) when installed, else the offline
# doubles. Install: cd backend && uv sync --extra voice && uv run python -m app.voice.models_setup
EV_VOICE_VOSK_MODEL_PATH=
EV_VOICE_WAKE_PHRASES=
EV_VOICE_WAKE_VOSK_THRESHOLD=0.55
EV_LIVE_FRAME_MS=20
EV_LIVE_ENDPOINT_SILENCE_MS=900
EV_LIVE_MIN_SPEECH_MS=240
EV_LIVE_MAX_UTTERANCE_MS=20000
EV_LIVE_WAKE_GRACE_MS=7000
EV_LIVE_FOLLOW_UP_MS=12000
EV_LIVE_BARGE_IN_MS=400
EV_LIVE_SPEECH_THRESHOLD=0.5
EV_LIVE_RING_SECONDS=30.0
EV_LIVE_ALLOW_UNENROLLED=true
EV_LIVE_VERIFY_SPEAKER=true
# --- EV VOICE CONTROL PLAN (append-only, 2026) --------------------------------
# docs/VOICE_CONTROL_PLAN.md — live speech surface modes for the realtime
# brain (Gemini Live gemini-3.8-live-extended-thinking).
# supervised = full curated surface (default, identical to previous behavior)
# shadow     = UI verbs + recall_history + generic capabilities only; history
#              is injected read-only as a SHADOW MEMORY block per owner turn
# autonomous  = zero tools; pure speech-to-speech chat (no memory, no actions)
EV_VOICE_LIVE_MODE=supervised
# Chunks injected per owner turn (shadow mode only)
EV_VOICE_SHADOW_K=5
# Token cap for the injected SHADOW MEMORY block (shadow mode only)
EV_VOICE_SHADOW_BUDGET_TOKENS=900
# Retrieval floor for shadow chunks (0.0 = include anything the hybrid engine ranks)
EV_VOICE_SHADOW_MIN_SCORE=0.0
# Kill-switch for the read/see/click/type/paste/key/scroll/drag UI verbs
EV_UI_VERB_TOOLS_ENABLED=true

# --- EV INTELLIGENCE LAYER (append-only, 2026) -------------------------------
# "" = off (default). "mimo" = MiMo reviews each completed spoken reply for
# bluffing / filler / feature steering and records the verdict in voice
# health. Observer only — never blocks or rewrites speech. Uses the
# OpenRouter credential (EV_OPENROUTER_API_KEY).
EV_INTELLIGENCE_LAYER=

# --- COGNITIVE OS V2 (append-only) -------------------------------------------
# The kernel is always on; legacy values select the same kernel.
# mimo_kernel = kernel mind (default topology). realtime_delegate = Gemini
# Live decides and hands medium-high work to MiMo via delegate_task.
# Talk sidecar forces EV_COGNITIVE_ROLE=voice_edge. Production :8000 is kernel.
EV_COGNITIVE_MODE=legacy_mini
EV_COGNITIVE_ROLE=auto
EV_COGNITIVE_KERNEL_URL=http://127.0.0.1:8000
EV_COGNITIVE_MAC_EXECUTE_URL=http://127.0.0.1:18000
EV_COGNITIVE_MAX_TOOL_TURNS=12
EV_COGNITIVE_CONVERSATION_TIMEOUT_SECONDS=25
EV_COGNITIVE_WORK_TIMEOUT_SECONDS=90
# Kernel-only spoken-speed overrides.
EV_COGNITIVE_CONVERSATION_REASONING_EFFORT=low
EV_COGNITIVE_WORK_REASONING_EFFORT=medium
EV_COGNITIVE_CONVERSATION_MAX_TOOL_TURNS=4

# --- MIMO BLESSED WIRING (append-only) --------------------------------------
# MiMo-V2.6-Flash is the one mind. Uncomment into .env so every channel
# (typed chat, voice pipeline, live Talk receipts, device text, coding
# jobs, desk/files/look, presence graphs) resolves to MiMo. Offline CI
# still defaults to echo in code, so leaving these commented keeps
# `make test` green with no keys.
#   EV_CHAT_PROVIDER=mimo
#   EV_MIMO_ENABLED=true
#   EV_COGNITIVE_MODE=mimo_kernel
#   EV_MIMO_MODEL=xiaomi/mimo-v2.6-flash
#   EV_OPENROUTER_API_KEY=            # FILL-ME: OpenAI-compatible key
#   EV_ALLOW_REMOTE_CHAT=true
# Speech stays split by design: Gemini Live is the mouth (speech direct,
# delegate_task for medium-high work). Live hearing via Gemini when wanted:
#   EV_VOICE_LIVE_BRAIN=gemini
#   EV_GOOGLE_API_KEY=                # FILL-ME: paid-tier Google AI key

# --- CAMERA/MEMORY FIELD WORK (owner-requested, 2026-09-10) -----------------
# Recorded-clip ingest. A clip's bytes land on Home Station, keyframes and
# audio are sampled locally (ffmpeg), and the derived memory carries a moment
# timeline plus a local transcript. Without ffmpeg every clip degrades honestly
# with degraded=true and no fabricated frames.
EV_VISION_CLIP_MAX_MB=64
EV_VISION_CLIP_MAX_FRAMES=6
# Raw clip pixels are the heaviest media the owner stores: default 30 days,
# while the derived memory (timeline, transcript) is kept until deleted.
EV_RETENTION_MEDIA_CLIP_DAYS=30

# --- CAMERA/MEMORY FIELD WORK (real perception, 2026-09-15) -----------------
# Local perception engines run on Home Station over the JPEG a client already
# sent: RT-DETR-v2-R18vd for COCO object labels and YuNet for face boxes that
# feed the consented roster. Weights are checksum-pinned in the ModelArbiter:
#   cd backend && uv run python -m app.ml.cli pull face-yunet detect-rtdetr-v2-r18vd
# Phone photo captures always store their pixels; ordinary looks and bursts
# store pixels only when this is 1 (default: ephemeral, derived memory only).
EV_VISION_STORE_LOOK_PIXELS=0
# Stored still pixels: -1 keeps them until the owner deletes them.
EV_RETENTION_MEDIA_STILL_DAYS=-1
# --- Web Push (VAPID) — PWA notification delivery (cycle 49) ---------------
# Generate once:
#   uv run --project backend python -c "
#     from py_vapid import Vapid; import base64
#     v = Vapid(); v.generate_keys()
#     print('private:', v.private_key.export_to_pem().decode())
#   "
# Or: npx web-push generate-vapid-keys
EV_WEB_PUSH_VAPID_PRIVATE_KEY=
EV_WEB_PUSH_VAPID_PUBLIC_KEY=
EV_WEB_PUSH_VAPID_SUBJECT=mailto:owner@evie.local

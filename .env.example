# EV configuration (copy to .env)
EV_ENVIRONMENT=dev
EV_DATABASE_URL=postgresql+psycopg://ev:ev@localhost:5432/ev
EV_REDIS_URL=redis://localhost:6379/0

# Single-user master key. CHANGE THIS.
EV_MASTER_KEY=change-me

# sync = process events inline (no Redis needed); queue = Redis/RQ workers
EV_PROCESSING_MODE=sync

# Embeddings: hash (offline dev) or http (OpenAI-compatible embedding API)
EV_EMBEDDING_PROVIDER=hash
EV_EMBEDDING_BASE_URL=https://api.openai.com/v1
EV_EMBEDDING_API_KEY=
EV_EMBEDDING_MODEL=text-embedding-3-small
EV_EMBEDDING_DIM=384

# Voiceprint enrollment: hash (offline dev/tests only) or http (local ECAPA-TDNN service).
# Hosted/remote encoders require explicit voice_enrollment consent with allow_remote_processing=true.
EV_VOICEPRINT_PROVIDER=hash
EV_VOICEPRINT_BASE_URL=
EV_VOICEPRINT_API_KEY=
EV_VOICEPRINT_MODEL=ecapa-tdnn-voxceleb
EV_VOICEPRINT_DIM=192
EV_VOICEPRINT_THRESHOLD=0.72

# Chat: echo (offline) or deepseek
EV_CHAT_PROVIDER=echo
EV_DEEPSEEK_BASE_URL=https://api.deepseek.com
EV_DEEPSEEK_API_KEY=
EV_DEEPSEEK_MODEL=deepseek-v4-flash-0731
EV_PERSONA_NAME=EV
EV_MODEL_CALL_LOG_ENABLED=true

EV_CONTEXT_BUDGET_TOKENS=20000
EV_MAX_RETRIEVAL_MEMORIES=50

EV_OBJECT_STORE_BACKEND=local
EV_STORAGE_ROOT=./storage
EV_ACCESS_LOG_ENABLED=true

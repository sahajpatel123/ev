<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ev.api</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/sahajpatel/Code/ev/backend &amp;&amp; set -a &amp;&amp; source ../.env 2&gt;/dev/null; set +a; exec uv run uvicorn app.main:app --host 127.0.0.1 --port 8000</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/sahajpatel/Code/ev/backend</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/sahajpatel/Library/Logs/ev/api.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sahajpatel/Library/Logs/ev/api.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/sahajpatel/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <!-- A long-lived API plus live sockets and subprocesses must not run into
         launchd's default 256-file soft limit (observed Errno 24). -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
</dict>
</plist>
